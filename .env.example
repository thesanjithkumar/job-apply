# Copy this to .env and fill in at least one AI provider key + your personal info.
# ─────────────────────────────────────────────────────────────────────────────

# ── Free AI providers (main.py ranking + apply.py humanizer) ─────────────────
# Add keys for whichever you have. Script tries top-to-bottom, skips on exhaustion.

GROQ_API_KEY=         # https://console.groq.com               (free, very generous)
CEREBRAS_API_KEY=     # https://cloud.cerebras.ai              (free tier)
OPENROUTER_API_KEY=   # https://openrouter.ai                  (free :free models)
GEMINI_API_KEY=       # https://aistudio.google.com            (free, 500 req/day Flash-Lite)
MISTRAL_API_KEY=      # https://console.mistral.ai             (free rate limits)
SAMBANOVA_API_KEY=    # https://cloud.sambanova.ai             ($5 free / 3 months)
NVIDIA_API_KEY=       # https://build.nvidia.com               (free tier)
KILO_API_KEY=         # https://kilo.ai                        (200 req/hour free)
SCALEWAY_API_KEY=     # https://console.scaleway.com           (1M free tokens)
HYPERBOLIC_API_KEY=   # https://app.hyperbolic.ai              ($1 free)
NEBIUS_API_KEY=       # https://tokenfactory.nebius.com        ($1 free)
FIREWORKS_API_KEY=    # https://fireworks.ai                   ($1 free)
NOVITA_API_KEY=       # https://novita.ai                      ($0.50 free / 1 year)
INFERENCE_API_KEY=    # https://inference.net                  ($1 free)
LAMBDA_API_KEY=       # https://lambdalabs.com                 (trial credits)
CHUTES_API_KEY=       # https://chutes.ai                      (free, open-source models)
OVH_API_KEY=          # https://endpoints.ai.cloud.ovh.net    (free tier)
HF_TOKEN=             # https://huggingface.co/settings/tokens ($0.10/month)
UPSTAGE_API_KEY=      # https://console.upstage.ai             ($10 free / 3 months)
KLUSTER_API_KEY=      # https://api.kluster.ai                 (trial credits)

# ── Your personal info (apply.py form filler) ────────────────────────────────
USER_FIRST_NAME=
USER_LAST_NAME=
USER_PHONE=
USER_LINKEDIN=https://linkedin.com/in/yourprofile

# ── LinkedIn session cookie (enables Easy Apply in CI) ───────────────────────
# Get it: linkedin.com → F12 → Application → Cookies → li_at → copy Value
# Valid for ~1 year. Re-copy and update the GitHub Secret if it expires.
LINKEDIN_LI_AT=

# ── Email sending (apply.py cold email) ─────────────────────────────────────
# Gmail: enable 2FA → https://myaccount.google.com/apppasswords → create App Password
EMAIL_FROM=you@gmail.com
EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_NAME=Your Full Name
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── Email finder ─────────────────────────────────────────────────────────────
# apply.py uses mailmeteor.com/tools via Playwright — no API key needed.
# Cloudflare Turnstile solves automatically in the headed Chromium window.
# No sign-up, no monthly limit. A fresh browser context is used per search
# to reset session cookies and avoid rate limiting.
